+# args a resumed run must share with the run that wrote the checkpoint (they fix the data order and the LR schedule)
+RESUME_KEYS = ["model", "data", "epochs", "lr", "wd", "warmup", "max_tokens", "accum", "max_ctx", "brier_w", "label_smooth",
+               "train_cap", "seed", "resample_every_epoch", "none_prob", "schema_first_prob", "max_options",
+               "lora_r", "lora_alpha", "lora_targets"]
+
+
+def dump_atomic(obj, path):
+    with open(path + ".tmp", "wb") as f:
+        pickle.dump(obj, f, protocol=pickle.HIGHEST_PROTOCOL)
+    os.replace(path + ".tmp", path)
+
+
+def save_ckpt(out, model, opt, state):
+    """Resume checkpoint at an optimizer-step boundary (no half-accumulated grads): weights, AdamW state, schedule position,
+    data order.  Written to ckpt.tmp and renamed into place, so a save killed half-way leaves the previous checkpoint usable."""
+    tmp, dst, old = f"{out}/ckpt.tmp", f"{out}/ckpt", f"{out}/ckpt.old"
+    shutil.rmtree(tmp, ignore_errors=True); os.makedirs(tmp)
+    torch.save(model.state_dict(), f"{tmp}/model.pt"); torch.save(opt.state_dict(), f"{tmp}/optim.pt")
+    torch.save(state, f"{tmp}/state.pt")                                  # written last: its presence marks a complete checkpoint
+    if os.path.exists(dst):
+        shutil.rmtree(old, ignore_errors=True); os.rename(dst, old)
+    os.rename(tmp, dst); shutil.rmtree(old, ignore_errors=True)
+
+
+def find_ckpt(out):
+    return next((d for d in (f"{out}/ckpt", f"{out}/ckpt.old") if os.path.exists(f"{d}/state.pt")), None)
+
