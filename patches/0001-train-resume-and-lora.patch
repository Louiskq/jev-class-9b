+class LoRALinear(torch.nn.Module):
+    """base(x) + (alpha / r) * B A x, with the base frozen and A, B trained in fp32.  B starts at zero, so the wrapped model
+    starts out exactly equal to the base model."""
+    def __init__(self, base, r, alpha):
+        super().__init__()
+        self.base, self.scale = base, alpha / r
+        self.A = torch.nn.Parameter(torch.empty(r, base.in_features, dtype=torch.float32, device=base.weight.device))
+        self.B = torch.nn.Parameter(torch.zeros(base.out_features, r, dtype=torch.float32, device=base.weight.device))
+        torch.nn.init.kaiming_uniform_(self.A, a=math.sqrt(5))
+
+    def forward(self, x):
+        return self.base(x) + F.linear(F.linear(x, self.A.to(x.dtype)), self.B.to(x.dtype)) * self.scale
+
+    @torch.no_grad()
+    def merged(self):
+        w = self.base.weight
+        w.copy_((w.float() + (self.B @ self.A) * self.scale).to(w.dtype))
+        return self.base
+
+
+def _swap(lm, pick):
+    for mod in list(lm.modules()):
+        for name, child in list(mod.named_children()):
+            new = pick(child)
+            if new is not child:
+                setattr(mod, name, new)
+
+
+def add_lora(lm, r, alpha, targets):
+    """Freeze lm and wrap every nn.Linear whose attribute name is in `targets`.  Returns the number wrapped."""
+    for p in lm.parameters():
+        p.requires_grad_(False)
+    n = 0
+    for mod in list(lm.modules()):
+        for name, child in list(mod.named_children()):
+            if name in targets and type(child) is torch.nn.Linear:
+                setattr(mod, name, LoRALinear(child, r, alpha)); n += 1
+    lm.enable_input_require_grads()      # gradient checkpointing needs a grad-requiring input when the embeddings are frozen
+    return n
+
+
+def merge_lora(lm):
+    """Fold every adapter into its base weight and put the plain nn.Linear back (idempotent)."""
+    _swap(lm, lambda m: m.merged() if isinstance(m, LoRALinear) else m)
+
+
+def finish_lora(model, a, log):
+    """Before a final save: keep the adapter (small, fp32) next to the run, then merge it so OUT/model is a plain checkpoint."""
+    if not any(isinstance(m, LoRALinear) for m in model.modules()):
+        return
+    torch.save({k: v for k, v in model.state_dict().items() if k.endswith((".A", ".B"))}, f"{a.out}/lora_adapter.pt")
+    merge_lora(model.lm); log("[lora] adapter saved to", f"{a.out}/lora_adapter.pt", "and merged into the weights")
+
+
+LORA_TARGETS = "q_proj,k_proj,v_proj,o_proj,in_proj_qkv,in_proj_z,out_proj,gate_proj,up_proj,down_proj"
+
